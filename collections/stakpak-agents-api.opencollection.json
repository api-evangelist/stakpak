          "http": {
            "method": "POST",
            "url": "https://apiv2.stakpak.dev/v2/:account/agents/sessions/checkpoints/:checkpoint_id/extract-memory",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path",
                "description": "Account name"
              },
              {
                "name": "checkpoint_id",
                "value": "",
                "type": "path",
                "description": "Checkpoint ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
