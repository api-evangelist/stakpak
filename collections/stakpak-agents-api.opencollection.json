{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stakpak Account Agents API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Agent Checkpoint Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apiv2.stakpak.dev/v1/agents/checkpoints/:checkpoint_id",
            "params": [
              {
                "name": "checkpoint_id",
                "value": "",
                "type": "path",
                "description": "Checkpoint ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get Agent Checkpoint Details"
        },
        {
          "info": {
            "name": "List Agent Memories",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://apiv2.stakpak.dev/v1/agents/memories",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "List Agent Memories"
        },
        {
          "info": {
            "name": "List Agent Sessions",
