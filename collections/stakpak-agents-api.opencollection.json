          "http": {
            "method": "GET",
            "url": "https://apiv2.stakpak.dev/v1/agents/sessions/:session_id/stats",
            "params": [
              {
                "name": "session_id",
                "value": "",
                "type": "path",
                "description": "Session ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
